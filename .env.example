# Kopieren nach ".env" und ausfüllen. Ohne KINDE_* läuft der Server lokal ohne Login (jeder ist Admin).
# Auf Render trägst du dieselben Werte im Dashboard unter "Environment" ein (keine .env hochladen).

# --- Daten (Supabase) ------------------------------------------------------
# Supabase -> Project Settings -> API: Project URL und "secret"/"service_role" Key.
# Der Key gehört NUR auf den Server, nie ins Frontend oder ins Repository.
# Ohne diese Werte speichert der Server lokal im Ordner "daten".
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Kinde -----------------------------------------------------------------
# Kinde Dashboard -> Einstellungen -> Anwendungen -> (Back-End Web-App)
KINDE_DOMAIN=https://DEINE-SUBDOMAIN.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
# Optional: Organisations-Code (Kinde -> Organisationen -> Details, z. B. org_abc123).
# Rollen (admin/player) gelten pro Organisation und stehen nur für diese im Token.
KINDE_ORG_CODE=
# Kennung (Audience) einer in Kinde angelegten API (Einstellungen -> APIs), für die die App
# freigeschaltet ist. Nötig, damit die Rollen (admin/player) im Access Token stehen.
KINDE_AUDIENCE=
# Optional: E-Mail-Adressen (kommagetrennt), die immer Admin sind, auch ohne Kinde-Rolle im Token.
ADMIN_EMAILS=

# --- Mail an Teilnehmer bei neuer Zahlungsanforderung (optional) -----------
# Variante A (für Render Free): Brevo-HTTP-API. Brevo -> SMTP & API -> API-Schlüssel.
#BREVO_API_KEY=
#MAIL_FROM=FC-M:Sys <deine-bei-brevo-bestaetigte-adresse>
# Variante B (lokal): SMTP, z. B. Brevo oder Gmail mit App-Passwort. Render Free sperrt SMTP-Ports.
#SMTP_HOST=smtp-relay.brevo.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#MAIL_FROM=FC-M:Sys <deine-adresse>

# --- Adresse und Cookie ------------------------------------------------------
# Öffentliche Adresse der App, OHNE Slash am Ende. Muss in Kinde als
#   "Allowed callback URL":  <PUBLIC_URL>/callback
#   "Allowed logout redirect URL": <PUBLIC_URL>
# eingetragen sein. Auf Render wird sie automatisch gesetzt (RENDER_EXTERNAL_URL), dann hier weglassen.
PUBLIC_URL=http://localhost:3000
# Zufälliger Schlüssel für das Login-Cookie (Render erzeugt ihn per render.yaml selbst):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
