# Kopieren nach ".env" und ausfüllen. Ohne KINDE_* läuft der Server lokal ohne Login (jeder ist Admin).
# Im Docker-Betrieb auf dem VPS liegt diese Datei als ".env" neben docker-compose.yml.
# PORT und HOST nicht setzen: der Container legt sie selbst fest.

# --- Adresse und Cookie ------------------------------------------------------
# Öffentliche Adresse der App, OHNE Slash am Ende. Muss in Kinde als
#   "Allowed callback URL":  <PUBLIC_URL>/callback
#   "Allowed logout redirect URL": <PUBLIC_URL>
# eingetragen sein. Lokal weglassen.
#PUBLIC_URL=https://www.fc-msys.de
# Weitere erlaubte Hostnamen (z. B. die Domain ohne www), kommagetrennt. Meist nicht nötig.
#ALLOWED_HOSTS=
# Zufälliger Schlüssel für das Login-Cookie:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Kinde -----------------------------------------------------------------
# Kinde Dashboard -> Einstellungen -> Anwendungen -> (Back-End Web-App)
KINDE_DOMAIN=https://DEINE-SUBDOMAIN.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
# Optional: Organisations-Code (Kinde -> Organisationen -> Details, z. B. org_abc123).
# Rollen (admin/player) gelten pro Organisation und stehen nur für diese im Token.
KINDE_ORG_CODE=
# Kennung (Audience) einer in Kinde angelegten API (Einstellungen -> APIs), für die die App
# freigeschaltet ist. Nötig, damit die Rollen (admin/player) im Access Token stehen.
KINDE_AUDIENCE=
# Optional: E-Mail-Adressen (kommagetrennt), die immer Admin sind, auch ohne Kinde-Rolle im Token.
ADMIN_EMAILS=

# --- Daten (Supabase) ------------------------------------------------------
# Supabase -> Project Settings -> API: Project URL und "secret"/"service_role" Key.
# Der Key gehört NUR auf den Server, nie ins Frontend oder ins Repository.
# Ohne diese Werte speichert der Server lokal (Ordner "daten", im Docker-Volume "daten").
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Mail (IONOS) ----------------------------------------------------------
# Einladungen, Zahlungsanforderungen und Erinnerungen gehen direkt über den IONOS-SMTP-Server.
# Benutzer = komplette Postfach-Adresse; MAIL_FROM muss diese Adresse (oder ein Alias) sein.
# Ohne SMTP_USER/SMTP_PASS werden keine Mails verschickt.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=info@fc-msys.de
SMTP_PASS=
MAIL_FROM=FC M:sys <info@fc-msys.de>
